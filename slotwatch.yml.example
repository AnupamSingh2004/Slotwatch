postgres:
  host: localhost
  port: 5432
  user: slotwatch
  password: ${SLOTWATCH_PG_PASSWORD}
  database: myapp
  replication_slot: slotwatch_slot
  publication: slotwatch_pub

kafka:
  brokers:
    - kafka:9092
  topic_prefix: postgres

pipeline:
  tables:
    - public.orders
    - public.users
  wal_lag_warn_threshold_bytes: 10485760

api:
  port: 8080
